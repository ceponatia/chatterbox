{
  "name": "chatterbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:status": "npx prisma migrate status",
    "db:reset": "npx prisma migrate reset",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:mutate": "pnpm -r --filter '@chatterbox/sockets' --filter '@chatterbox/state-model' run test:mutate",
    "test:mutate:all": "pnpm -r run test:mutate",
    "test:e2e": "pnpm --filter web exec playwright test",
    "test:e2e:ui": "pnpm --filter web exec playwright test --ui",
    "test:e2e:headed": "pnpm --filter web exec playwright test --headed",
    "fetch:providers": "node --experimental-strip-types scripts/fetch-providers.ts",
    "validate:schema": "node --experimental-strip-types scripts/validate-character-schema.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/client": "^7.4.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "eslint": "^9",
    "eslint-plugin-boundaries": "^5",
    "prisma": "^7.0.0",
    "typescript": "^5"
  }
}